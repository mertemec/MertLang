import re
import sys

DATA_CODES = {
    "AAA": "000", "AAB": "001", "AAC": "002",
    "ABA": "010", "ABB": "011", "ABC": "012",
    "ACA": "020", "ACB": "021", "ACC": "022",
    "BAA": "100", "BAB": "101", "BAC": "102",
    "BBA": "110", "BBB": "111", "BBC": "112",
    "BCA": "120", "BCB": "121", "BCC": "122",
    "CAA": "200", "CAB": "201", "CAC": "202",
    "CBA": "210", "CBB": "211", "CBC": "212",
    "CCA": "220", "CCB": "221", "CCC": "222",
    "ZYF": "999",
}

variables = {}
constants = {}

def error(message, line_number):
    print(f"ERROR on line {line_number}: {message}")
    sys.exit(1)

def run(source):
    for line_number, raw_line in enumerate(source.splitlines(), 1):
        line = raw_line.strip()

        if not line:
            continue

        # Değişken oluşturma
        match = re.fullmatch(
            r'des "([^"]+)" = ([A-Z]{3})',
            line
        )

        if match:
            name, value = match.groups()

            if name in variables or name in constants:
                error(f"NAME_ALREADY_EXISTS: {name}", line_number)

            if value not in DATA_CODES:
                error(f"INVALID_DATA_CODE: {value}", line_number)

            variables[name] = value
            continue

        # Değişken değiştirme
        match = re.fullmatch(
            r'des "([^"]+)" change = ([A-Z]{3})',
            line
        )

        if match:
            name, value = match.groups()

            if value not in DATA_CODES:
                error(f"INVALID_DATA_CODE: {value}", line_number)

            if name in constants:
                error(f"CONSTANT_CHANGE: {name}", line_number)

            if name not in variables:
                error(f"UNDEFINED_VARIABLE: {name}", line_number)

            variables[name] = value
            continue

        # Sabit oluşturma
        match = re.fullmatch(
            r'dat "([^"]+)" = ([A-Z]{3})',
            line
        )

        if match:
            name, value = match.groups()

            if name in variables or name in constants:
                error(f"NAME_ALREADY_EXISTS: {name}", line_number)

            if value not in DATA_CODES:
                error(f"INVALID_DATA_CODE: {value}", line_number)

            constants[name] = value
            continue

        # Sabit değiştirme girişimi
        match = re.fullmatch(
            r'dat "([^"]+)" change = ([A-Z]{3})',
            line
        )

        if match:
            name, _ = match.groups()
            error(f"CONSTANT_CHANGE: {name}", line_number)

        # Metin yazdırma
        match = re.fullmatch(
            r'txtf "([^"]*)" as lettergroup; end\.as',
            line
        )

        if match:
            print(match.group(1))
            continue

        error("INVALID_SYNTAX", line_number)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 main.py program.mert")
        sys.exit(1)

    with open(sys.argv[1], "r", encoding="utf-8") as file:
        run(file.read())
